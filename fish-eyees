    <script src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.8.5/d3.min.js"></script>
    <script>
        // Fish school system
        class FishSchool {
            constructor() {
                this.fish = [];
                this.mouseX = window.innerWidth / 2;
                this.mouseY = window.innerHeight / 2;
                this.container = document.getElementById('fishContainer');
                this.cursorLight = document.querySelector('.cursor-light');
                
                this.initFish();
                this.bindEvents();
                this.animate();
            }
            
            initFish() {
                const fishCount = 120;
                const colors = ['#10B981', '#3B82F6', '#8B5CF6', '#EC4899', '#F59E0B', '#EF4444', '#06B6D4', '#8B5A2B', '#DB2777', '#7C3AED', '#059669', '#DC2626', '#14B8A6', '#F97316', '#A855F7', '#E11D48'];
                
                for (let i = 0; i < fishCount; i++) {
                    const fish = {
                        id: i,
                        x: Math.random() * window.innerWidth,
                        y: Math.random() * window.innerHeight,
                        vx: (Math.random() - 0.5) * 2,
                        vy: (Math.random() - 0.5) * 2,
                        size: Math.random() * 16 + 4,
                        color: colors[Math.floor(Math.random() * colors.length)],
                        angle: 0,
                        phase: Math.random() * Math.PI * 2,
                        speed: Math.random() * 1.2 + 0.8,
                        element: null,
                        schoolGroup: Math.floor(i / 20), // Create smaller sub-groups
                        individualPhase: Math.random() * Math.PI * 4,
                        agility: Math.random() * 0.5 + 0.7, // Individual agility factor
                        energy: Math.random() * 0.3 + 0.8 // Energy level for movement
                    };
                    
                    // Create fish SVG element
                    fish.element = this.createFishElement(fish);
                    this.container.appendChild(fish.element);
                    this.fish.push(fish);
                }
            }
            
            createFishElement(fish) {
                const div = document.createElement('div');
                div.className = 'small-fish';
                div.innerHTML = `
                    <svg width="${fish.size * 2.2}" height="${fish.size * 1.1}" viewBox="0 0 44 22">
                        <defs>
                            <linearGradient id="fishGrad${fish.id}" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" style="stop-color:${fish.color};stop-opacity:0.9" />
                                <stop offset="50%" style="stop-color:${fish.color};stop-opacity:0.7" />
                                <stop offset="100%" style="stop-color:${fish.color};stop-opacity:0.5" />
                            </linearGradient>
                        </defs>
                        <ellipse cx="28" cy="11" rx="14" ry="7" fill="url(#fishGrad${fish.id})"/>
                        <path d="M 8 11 L 2 7 L 2 15 Z" fill="url(#fishGrad${fish.id})"/>
                        <ellipse cx="35" cy="9" rx="2" ry="3" fill="rgba(255,255,255,0.8)"/>
                        <circle cx="35" cy="9" r="1.2" fill="black"/>
                        <circle cx="35.5" cy="8.5" r="0.4" fill="white"/>
                        <!-- Small dorsal fin -->
                        <path d="M 25 4 Q 28 2, 30 4 Q 28 6, 25 4" fill="url(#fishGrad${fish.id})" opacity="0.8"/>
                    </svg>
                `;
                return div;
            }
            
            bindEvents() {
                document.addEventListener('mousemove', (e) => {
                    this.mouseX = e.clientX;
                    this.mouseY = e.clientY;
                    
                    // Update cursor light position
                    this.cursorLight.style.left = e.clientX + 'px';
                    this.cursorLight.style.top = e.clientY + 'px';
                });
                
                // Handle window resize
                window.addEventListener('resize', () => {
                    this.mouseX = window.innerWidth / 2;
                    this.mouseY = window.innerHeight / 2;
                });
            }
            
            updateFish() {
                this.fish.forEach((fish, index) => {
                    // Calculate distance to mouse
                    const dx = this.mouseX - fish.x;
                    const dy = this.mouseY - fish.y;
                    const distance = Math.sqrt(dx * dx + dy * dy);
                    
                    // Much stronger attraction to mouse with faster response
                    const attractionStrength = 0.008 * fish.agility;
                    const maxDistance = 400;
                    const influence = Math.max(0, 1 - distance / maxDistance);
                    const urgency = Math.max(0.3, 1 - distance / 200); // Close fish move more urgently
                    
                    fish.vx += dx * attractionStrength * influence * fish.speed * urgency;
                    fish.vy += dy * attractionStrength * influence * fish.speed * urgency;
                    
                    // Enhanced flocking behavior with faster reactions
                    let separationX = 0;
                    let separationY = 0;
                    let cohesionX = 0;
                    let cohesionY = 0;
                    let alignmentX = 0;
                    let alignmentY = 0;
                    let nearbyCount = 0;
                    let schoolCount = 0;
                    
                    this.fish.forEach((otherFish, otherIndex) => {
                        if (index !== otherIndex) {
                            const otherDx = fish.x - otherFish.x;
                            const otherDy = fish.y - otherFish.y;
                            const otherDistance = Math.sqrt(otherDx * otherDx + otherDy * otherDy);
                            
                            // Stronger separation (avoid crowding)
                            if (otherDistance < 35 && otherDistance > 0) {
                                const separationForce = 1 / otherDistance;
                                separationX += (otherDx / otherDistance) * separationForce;
                                separationY += (otherDy / otherDistance) * separationForce;
                                nearbyCount++;
                            }
                            
                            // Cohesion and alignment for same school group
                            if (fish.schoolGroup === otherFish.schoolGroup && otherDistance < 80 && otherDistance > 0) {
                                cohesionX += otherFish.x;
                                cohesionY += otherFish.y;
                                alignmentX += otherFish.vx;
                                alignmentY += otherFish.vy;
                                schoolCount++;
                            }
                        }
                    });
                    
                    // Apply stronger separation
                    if (nearbyCount > 0) {
                        fish.vx += (separationX / nearbyCount) * 0.15 * fish.agility;
                        fish.vy += (separationY / nearbyCount) * 0.15 * fish.agility;
                    }
                    
                    // Apply cohesion (move toward center of school group)
                    if (schoolCount > 0) {
                        cohesionX = cohesionX / schoolCount - fish.x;
                        cohesionY = cohesionY / schoolCount - fish.y;
                        fish.vx += cohesionX * 0.003 * fish.energy;
                        fish.vy += cohesionY * 0.003 * fish.energy;
                        
                        // Apply alignment (match velocity of school group)
                        alignmentX /= schoolCount;
                        alignmentY /= schoolCount;
                        fish.vx += (alignmentX - fish.vx) * 0.05 * fish.agility;
                        fish.vy += (alignmentY - fish.vy) * 0.05 * fish.agility;
                    }
                    
                    // More active individual swimming motion
                    fish.phase += 0.15 + (fish.speed * 0.05);
                    fish.individualPhase += 0.08 + (fish.energy * 0.02);
                    fish.vx += Math.sin(fish.phase + fish.individualPhase) * 0.004 * fish.energy;
                    fish.vy += Math.cos(fish.phase * 0.8 + fish.individualPhase) * 0.004 * fish.energy;
                    
                    // Add more dynamic turbulence for natural movement
                    fish.vx += (Math.random() - 0.5) * 0.003 * fish.agility;
                    fish.vy += (Math.random() - 0.5) * 0.003 * fish.agility;
                    
                    // Less drag for faster movement
                    fish.vx *= 0.88;
                    fish.vy *= 0.88;
                    
                    // Higher velocity limits for faster movement
                    const maxSpeed = 4.5 + (fish.size / 10) + (fish.energy * 2);
                    const speed = Math.sqrt(fish.vx * fish.vx + fish.vy * fish.vy);
                    if (speed > maxSpeed) {
                        fish.vx = (fish.vx / speed) * maxSpeed;
                        fish.vy = (fish.vy / speed) * maxSpeed;
                    }
                    
                    // Boost speed when near cursor
                    if (distance < 150) {
                        const speedBoost = 1 + (1 - distance / 150) * 0.5;
                        fish.vx *= speedBoost;
                        fish.vy *= speedBoost;
                    }
                    
                    // Update position
                    fish.x += fish.vx;
                    fish.y += fish.vy;
                    
                    // Wrap around screen edges with some margin
                    const margin = 60;
                    if (fish.x < -margin) fish.x = window.innerWidth + margin;
                    if (fish.x > window.innerWidth + margin) fish.x = -margin;
                    if (fish.y < -margin) fish.y = window.innerHeight + margin;
                    if (fish.y > window.innerHeight + margin) fish.y = -margin;
                    
                    // Calculate rotation angle based on velocity
                    if (Math.abs(fish.vx) > 0.05 || Math.abs(fish.vy) > 0.05) {
                        fish.angle = Math.atan2(fish.vy, fish.vx) * (180 / Math.PI);
                    }
                    
                    // More dynamic scaling based on speed
                    const speedScale = Math.min(1.3, 0.8 + speed / 8);
                    const pulseScale = 1 + Math.sin(fish.phase * 2) * 0.08;
                    
                    // Update visual position and rotation
                    fish.element.style.left = fish.x + 'px';
                    fish.element.style.top = fish.y + 'px';
                    fish.element.style.transform = `rotate(${fish.angle}deg) scale(${speedScale * pulseScale})`;
                    
                    // More dynamic opacity variation
                    const baseOpacity = 0.75 + (fish.size / 40);
                    const distanceOpacity = Math.max(0.4, 1 - distance / 600);
                    const speedOpacity = Math.min(1, 0.6 + speed / 10);
                    const finalOpacity = Math.min(baseOpacity * distanceOpacity * speedOpacity, 0.95);
                    fish.element.style.opacity = finalOpacity;
                });
            }
            
            animate() {
                this.updateFish();
                requestAnimationFrame(() => this.animate());
            }
        }
        
        // Bubble system
        function createBubble() {
            const bubble = document.createElement('div');
            bubble.className = 'bubble';
            
            const size = Math.random() * 20 + 5;
            const left = Math.random() * window.innerWidth;
            const duration = Math.random() * 10 + 8;
            
            bubble.style.width = size + 'px';
            bubble.style.height = size + 'px';
            bubble.style.left = left + 'px';
            bubble.style.animationDuration = duration + 's';
            
            document.getElementById('bubbles').appendChild(bubble);
            
            setTimeout(() => {
                if (bubble.parentNode) {
                    bubble.parentNode.removeChild(bubble);
                }
            }, duration * 1000);
        }
        
        // Whale interaction
        function initWhaleInteraction() {
            const whales = document.querySelectorAll('.whale');
            
            document.addEventListener('mousemove', (e) => {
                const mouseX = e.clientX / window.innerWidth;
                const mouseY = e.clientY / window.innerHeight;
                
                whales.forEach((whale, index) => {
                    const moveX = (mouseX - 0.5) * (10 + index * 5);
                    const moveY = (mouseY - 0.5) * (5 + index * 3);
                    
                    whale.style.transform = `translate(${moveX}px, ${moveY}px)`;
                });
            });
        }
        
        // Initialize everything
        document.addEventListener('DOMContentLoaded', () => {
            new FishSchool();
            initWhaleInteraction();
            
            // Create bubbles periodically
            setInterval(createBubble, 2000);
            
            // Create initial bubbles
            for (let i = 0; i < 5; i++) {
                setTimeout(createBubble, i * 400);
            }
        });
    </script>
</body>
</html>
